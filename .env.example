# ---------------------------------------------------------------------------
# LIFELINE ACHHAM - Environment configuration
# Copy this file to .env in apps/api and apps/web (values differ per app,
# see comments below). NEVER commit real secrets to git.
# ---------------------------------------------------------------------------

### apps/api/.env ###
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://lifeline:lifeline@localhost:5432/lifeline_achham?schema=public

# Auth
AUTH_JWT_SECRET=change-me-super-secret
AUTH_JWT_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=change-me-refresh-secret
AUTH_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_NAME=lifeline_session
AUTH_COOKIE_SECURE=false

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Payment gateways (Phase 3 - not wired up yet, config only)
ESEWA_MERCHANT_CODE=
ESEWA_SECRET=
ESEWA_CLIENT_ID=
ESEWA_VERIFY_URL=

KHALTI_SECRET_KEY=
KHALTI_VERIFY_URL=

CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=
CONNECTIPS_CONFIG=

# Object storage (Phase 4 - file uploads)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=lifeline-achham-documents

# AI Assistant (Phase 7)
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Backups (Section 30) - requires the `pg_dump`/`psql` client tools to be
# installed on whatever host runs this API (they ship with the postgresql
# client package on any Linux distro / Homebrew / the official Postgres
# installer - not something npm can install).
BACKUP_DIR=./backups
BACKUP_AUTOMATIC_ENABLED=false
BACKUP_AUTOMATIC_CRON=0 2 * * *

### apps/web/.env.local ###
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Lifeline Achham
NEXT_PUBLIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
